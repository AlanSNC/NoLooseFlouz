{% extends 'base.html.twig' %}

{% block title %}Créer une catégorie{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 540px;">
        <div class="card-body">
            <h2 class="mb-4"><i class="bi bi-plus-circle"></i> Créer une catégorie</h2>
            <form method="post" autocomplete="off">
                <div class="mb-3">
                    <label for="name" class="form-label">Nom de la catégorie</label>
                    <input type="text" class="form-control" id="name" name="name" required placeholder="Ex : Courses, Restaurant..." autofocus>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Créer</button>
                    <a href="{{ path('app_category') }}" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
