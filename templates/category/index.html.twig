{% extends 'base.html.twig' %}

{% block title %}Liste des catégories{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="mb-4"><i class="bi bi-tags"></i> Catégories</h2>
            <a href="{{ path('category_create') }}" class="btn btn-success mb-3"><i class="bi bi-plus-circle"></i> Créer une catégorie</a>
            <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for category in categories %}
                    <tr>
                        <td>{{ category.id }}</td>
                        <td><span class="badge bg-primary">{{ category.name }}</span></td>
                        <td class="text-end">
                            <a href="{{ path('category_edit', {'id': category.id}) }}" class="btn btn-outline-primary btn-sm" title="Modifier"><i class="bi bi-pencil"></i></a>
                            <form method="post" action="{{ path('category_delete', {id: category.id}) }}" style="display:inline-block" onsubmit="return confirm('Supprimer cette catégorie ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                <button class="btn btn-outline-danger btn-sm ms-1" title="Supprimer"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="text-center">Aucune catégorie</td></tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
