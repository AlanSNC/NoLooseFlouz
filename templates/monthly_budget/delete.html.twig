{% extends 'base.html.twig' %}

{% block title %}Supprimer le budget mensuel{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 540px;">
        <div class="card-body">
            <h2 class="mb-4 text-danger"><i class="bi bi-trash"></i> Supprimer le budget mensuel</h2>
            <p class="mb-4">Êtes-vous sûr de vouloir supprimer le budget du <strong>{{ budget.month }}/{{ budget.year }}</strong> pour <strong>{{ budget.amount }} €</strong> ?</p>
            <form method="post" class="d-flex justify-content-between align-items-center">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Supprimer</button>
                <a href="{{ path('monthly_budget_index') }}" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Annuler</a>
            </form>
        </div>
    </div>
</div>
{% endblock %}
