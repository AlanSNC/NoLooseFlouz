{% extends 'base.html.twig' %}

{% block title %}{{ edit_mode is defined and edit_mode ? 'Modifier le budget mensuel' : 'Créer un budget mensuel' }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 540px;">
        <div class="card-body">
            <h2 class="mb-4">{% if edit_mode is defined and edit_mode %}<i class="bi bi-pencil"></i> Modifier le budget mensuel{% else %}<i class="bi bi-plus-circle"></i> Créer un budget mensuel{% endif %}</h2>
            <form method="post" autocomplete="off">
                <div class="mb-3">
                    <label for="month" class="form-label">Mois</label>
                    <input type="number" id="month" name="month" class="form-control" min="1" max="12" required placeholder="1 à 12" value="{{ budget.month is defined ? budget.month : '' }}">
                </div>
                <div class="mb-3">
                    <label for="year" class="form-label">Année</label>
                    <input type="number" id="year" name="year" class="form-control" min="2000" max="2100" required placeholder="2025" value="{{ budget.year is defined ? budget.year : '' }}">
                </div>
                <div class="mb-3">
                    <label for="amount" class="form-label">Montant</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-currency-euro"></i></span>
                        <input type="number" id="amount" name="amount" class="form-control" required placeholder="0.00" value="{{ budget.amount is defined ? budget.amount : '' }}">
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> {{ edit_mode is defined and edit_mode ? 'Enregistrer' : 'Créer' }}</button>
                    <a href="{{ path('monthly_budget_index') }}" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
