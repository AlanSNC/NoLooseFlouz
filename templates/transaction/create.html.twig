{% extends 'base.html.twig' %}

{% block title %}Ajouter une dépense{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 540px;">
        <div class="card-body">
            <h2 class="mb-4"><i class="bi bi-plus-circle"></i> Ajouter une dépense</h2>
            <form method="post" autocomplete="off">
                <div class="mb-3">
                    <label for="amount" class="form-label">Montant</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-currency-euro"></i></span>
                        <input type="number" step="0.01" class="form-control" id="amount" name="amount" required placeholder="0.00" autofocus>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="currency" class="form-label">Devise</label>
                    <input type="text" class="form-control" id="currency" name="currency" value="EUR" required maxlength="3" placeholder="EUR">
                </div>
                <div class="mb-3">
                    <label for="date" class="form-label">Date</label>
                    <input type="date" class="form-control" id="date" name="date" required>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <input type="text" class="form-control" id="description" name="description" placeholder="Ex : courses, restaurant...">
                </div>
                <div class="mb-3">
                    <label for="category" class="form-label">Catégorie</label>
                    <select class="form-select" id="category" name="category" required>
                        <option value="">Choisir...</option>
                        {% for cat in categories %}
                            <option value="{{ cat.id }}">{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Ajouter</button>
                    <a href="{{ path('transaction_index') }}" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
