{% extends 'base.html.twig' %}

{% block title %}Supprimer la transaction{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 540px;">
        <div class="card-body">
            <h2 class="mb-4 text-danger"><i class="bi bi-trash"></i> Supprimer la transaction</h2>
            <p class="mb-4">Êtes-vous sûr de vouloir supprimer la transaction du <strong>{{ transaction.date|date('Y-m-d') }}</strong> pour <strong>{{ transaction.amountOriginal }} {{ transaction.currencyOriginal }}</strong> ?</p>
            <form method="post" class="d-flex justify-content-between align-items-center">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Supprimer</button>
                <a href="{{ path('transaction_index') }}" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Annuler</a>
            </form>
        </div>
    </div>
</div>
{% endblock %}
