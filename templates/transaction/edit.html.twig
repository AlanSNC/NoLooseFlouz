{% extends 'base.html.twig' %}

{% block title %}Modifier la transaction{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2>Modifier la transaction</h2>
    {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endif %}
    <form method="post">
        <div class="mb-3">
            <label for="amount" class="form-label">Montant</label>
            <input type="number" step="0.01" class="form-control" id="amount" name="amount" value="{{ transaction.amountOriginal }}" required>
        </div>
        <div class="mb-3">
            <label for="currency" class="form-label">Devise</label>
            <input type="text" class="form-control" id="currency" name="currency" value="{{ transaction.currencyOriginal }}" required>
        </div>
        <div class="mb-3">
            <label for="date" class="form-label">Date</label>
            <input type="date" class="form-control" id="date" name="date" value="{{ transaction.date|date('Y-m-d') }}" required>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <input type="text" class="form-control" id="description" name="description" value="{{ transaction.description }}">
        </div>
        <div class="mb-3">
            <label for="category" class="form-label">Catégorie</label>
            <select class="form-control" id="category" name="category" required>
                <option value="">Choisir...</option>
                {% for cat in categories %}
                    <option value="{{ cat.id }}" {% if transaction.categoryId and transaction.categoryId.id == cat.id %}selected{% endif %}>{{ cat.name }}</option>
                {% endfor %}
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a href="{{ path('transaction_list') }}" class="btn btn-secondary">Annuler</a>
    </form>
</div>
{% endblock %}
