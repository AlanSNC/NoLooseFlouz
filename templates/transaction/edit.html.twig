{% extends 'base.html.twig' %}

{% block title %}Modifier la transaction{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 540px;">
        <div class="card-body">
            <h2 class="mb-4"><i class="bi bi-pencil"></i> Modifier la transaction</h2>
            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}
            <form method="post" autocomplete="off">
                <div class="mb-3">
                    <label for="amount" class="form-label">Montant</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-currency-euro"></i></span>
                        <input type="number" step="0.01" class="form-control" id="amount" name="amount" value="{{ transaction.amountOriginal }}" required autofocus>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="currency" class="form-label">Devise</label>
                    <input type="text" class="form-control" id="currency" name="currency" value="{{ transaction.currencyOriginal }}" required maxlength="3">
                </div>
                <div class="mb-3">
                    <label for="date" class="form-label">Date</label>
                    <input type="date" class="form-control" id="date" name="date" value="{{ transaction.date|date('Y-m-d') }}" required>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <input type="text" class="form-control" id="description" name="description" value="{{ transaction.description }}">
                </div>
                <div class="mb-3">
                    <label for="category" class="form-label">Catégorie</label>
                    <select class="form-select" id="category" name="category" required>
                        <option value="">Choisir...</option>
                        {% for cat in categories %}
                            <option value="{{ cat.id }}" {% if transaction.categoryId and transaction.categoryId.id == cat.id %}selected{% endif %}>{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Enregistrer</button>
                    <a href="{{ path('transaction_index') }}" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
