{% extends 'base.html.twig' %}

{% block title %}Transactions{% endblock %}

{% block body %}
<h1>Mes transactions</h1>
<a href="{{ path('transaction_create') }}" class="btn btn-success mb-3">Ajouter une transaction</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Montant</th>
            <th>Devise</th>
            <th>Catégorie</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
    {% for transaction in transactions %}
        <tr>
            <td>{{ transaction.date ? transaction.date|date('Y-m-d') : '' }}</td>
            <td>{{ transaction.amountOriginal }}</td>
            <td>{{ transaction.currencyOriginal }}</td>
            <td>{{ transaction.categoryId ? transaction.categoryId.name : '' }}</td>
            <td>{{ transaction.description }}</td>
        </tr>
    {% else %}
        <tr><td colspan="5">Aucune transaction.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
