{% extends 'base.html.twig' %}

{% block body %}
<h2>Connexion</h2>
<form method="post" action="{{ path('user_login') }}">
    <label>Email</label>
    <input type="email" name="_username" required>

    <label>Mot de passe</label>
    <input type="password" name="_password" required>

    <button type="submit">Se connecter</button>
</form>

{% if app.flashes('error') %}
    <div class="alert alert-danger mt-2">
        {% for message in app.flashes('error') %}{{ message }}<br>{% endfor %}
    </div>
{% endif %}

<a href="{{ path('user_register') }}">Créer un compte</a>
{% endblock %}
