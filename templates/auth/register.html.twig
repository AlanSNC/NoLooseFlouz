{% extends 'base.html.twig' %}

{% block body %}
<h2>Créer un compte</h2>
{{ form_start(form) }}
    {{ form_row(form.email) }}
    {{ form_row(form.password.first) }}
    {{ form_row(form.password.second) }}
    {{ form_row(form.submit) }}
{{ form_end(form) }}

<a href="{{ path('user_login') }}">Déjà un compte ? Connexion</a>
{% endblock %}
