{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<h1 class="mb-4"><i class="bi bi-speedometer2"></i> Dashboard</h1>
<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card text-bg-primary shadow-sm h-100">
            <div class="card-body text-center">
                <h5 class="card-title"><i class="bi bi-wallet2"></i> Solde global</h5>
                <p class="card-text display-5 fw-bold">{{ solde|default(0) }} €</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-bg-success shadow-sm h-100">
            <div class="card-body text-center">
                <h5 class="card-title"><i class="bi bi-calendar2-week"></i> Budget du mois</h5>
                <p class="card-text display-5 fw-bold">{{ budget_mois|default(0) }} €</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-bg-danger shadow-sm h-100">
            <div class="card-body text-center">
                <h5 class="card-title"><i class="bi bi-cash-stack"></i> Dépenses du mois</h5>
                <p class="card-text display-5 fw-bold">{{ depenses_mois|default(0) }} €</p>
            </div>
        </div>
    </div>
</div>
{% if alerte_depassement %}
    <div class="alert alert-warning fade-in"><i class="bi bi-exclamation-triangle"></i> Attention : vous avez dépassé votre budget mensuel !</div>
{% endif %}
<div class="row mt-4">
    <div class="col-md-6 mb-4">
        <div class="card p-3">
            <h6 class="mb-3"><i class="bi bi-pie-chart"></i> Répartition par catégorie</h6>
            <canvas id="pieCategories" height="220"></canvas>
            <div id="pieHelp" class="text-muted small mt-2" style="display:none;">Aucune donnée à afficher pour ce mois.</div>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card p-3">
            <h6 class="mb-3"><i class="bi bi-bar-chart"></i> Dépenses par mois</h6>
            <canvas id="barMois" height="220"></canvas>
            <div id="barHelp" class="text-muted small mt-2" style="display:none;">Aucune donnée à afficher pour cette année.</div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
<script>
const pieData = {{ chart_categories|default('{}')|raw }};
const barData = {{ chart_mois|default('{}')|raw }};
const palette = [
    '#4F8A8B', '#FBD46D', '#F76B8A', '#24305E', '#A3D2CA', '#FFB085', '#6C63FF', '#FF6F61', '#2D4059', '#EA5455', '#FFD460', '#3EC1D3'
];
// Pie chart
if (pieData && pieData.labels && pieData.labels.length > 0) {
    pieData.datasets[0].backgroundColor = palette.slice(0, pieData.labels.length);
    new Chart(document.getElementById('pieCategories'), {
        type: 'pie',
        data: pieData,
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom', labels: { color: getComputedStyle(document.body).color, font: { size: 16 } } },
                title: { display: true, text: 'Répartition des dépenses par catégorie', color: getComputedStyle(document.body).color, font: { size: 18, weight: 'bold' } },
                tooltip: { callbacks: { label: ctx => `${ctx.label}: ${ctx.parsed} €` } },
                datalabels: { color: '#222', font: { weight: 'bold' }, formatter: v => v + ' €' }
            },
            animation: { animateScale: true, animateRotate: true },
            layout: { padding: 10 },
            borderWidth: 2,
            borderColor: '#fff',
        },
        plugins: [ChartDataLabels]
    });
} else {
    document.getElementById('pieHelp').style.display = 'block';
}
// Bar chart
if (barData && barData.labels && barData.datasets && barData.datasets[0].data.some(v => v > 0)) {
    barData.datasets[0].backgroundColor = palette[0];
    new Chart(document.getElementById('barMois'), {
        type: 'bar',
        data: barData,
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                title: { display: true, text: 'Dépenses mensuelles', color: getComputedStyle(document.body).color, font: { size: 18, weight: 'bold' } },
                tooltip: { callbacks: { label: ctx => `${ctx.parsed.y} €` } },
                datalabels: { anchor: 'end', align: 'top', color: getComputedStyle(document.body).color, font: { weight: 'bold' }, formatter: v => v > 0 ? v + ' €' : '' }
            },
            scales: {
                x: { ticks: { color: getComputedStyle(document.body).color, font: { size: 14 } }, grid: { color: '#eee' } },
                y: { beginAtZero: true, ticks: { color: getComputedStyle(document.body).color, font: { size: 14 } }, grid: { color: '#eee' } }
            },
            layout: { padding: 10 },
            borderRadius: 8,
            borderSkipped: false,
            animation: { duration: 900, easing: 'easeOutBounce' }
        },
        plugins: [ChartDataLabels]
    });
} else {
    document.getElementById('barHelp').style.display = 'block';
}
</script>
{% endblock %}
